# NewsAxis Environment Variables
# Copy this file to .env.local for local development

# Browser-Safe Public Variables (Must use VITE_ prefix)
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a854c5d0026a9224d01
VITE_APPWRITE_DATABASE_ID=6ab613fc0006b9fedac1
VITE_APPWRITE_BUCKET_ID=6ab614cc0022aa43fab8

# Server-Side Variables (Appwrite Server / Node.js Backend)
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a854c5d0026a9224d01
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=6ab613fc0006b9fedac1
APPWRITE_BUCKET_ID=6ab614cc0022aa43fab8

# Optional Third-Party News API Keys
VITE_THENEWSAPI_KEY=
VITE_GNEWS_API_KEY=
VITE_NEWSDATA_API_KEY=
VITE_MEDIASTACK_API_KEY=
VITE_NEWSAPI_KEY=

# Retention & Cycle Policies
NEWS_RETENTION_MINUTES=30
USER_POST_RETENTION_HOURS=24
EXTERNAL_CACHE_HOURS=0.5
VITE_USE_DEMO_DATA=false

# ==============================================================================
# GITHUB SECRETS CONFIGURATION
# In GitHub Repo -> Settings -> Secrets and variables -> Actions -> New repository secret:
# 1. APPWRITE_API_KEY
# 2. VITE_APPWRITE_PROJECT_ID
# 3. VITE_APPWRITE_DATABASE_ID
# 4. VITE_APPWRITE_BUCKET_ID
# 5. VITE_APPWRITE_ENDPOINT
# ==============================================================================
