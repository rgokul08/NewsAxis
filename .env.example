# NewsAxis Environment Variables
# Duplicate this file as .env.local for development

# Browser-Safe Public Variables (Must use VITE_ prefix)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=newsaxis-main
VITE_APPWRITE_BUCKET_ID=newsaxis-media

# Optional Third-Party News API Keys
VITE_GNEWS_API_KEY=
VITE_NEWSDATA_API_KEY=

# Local / Demo Mode Switch (set to true to test with seed fixtures)
VITE_USE_DEMO_DATA=false

# Server-Side Variables (Appwrite Functions / Vercel Secrets - DO NOT USE VITE_)
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=newsaxis-main
APPWRITE_BUCKET_ID=newsaxis-media
USER_POST_RETENTION_HOURS=72
EXTERNAL_CACHE_HOURS=48
APP_BASE_URL=https://newsaxis.vercel.app
